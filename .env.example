# Copy to .env and fill in. `npm start` and `npm run seed` load it automatically.

# 32-byte key (base64) that encrypts tenants' provider API keys at rest. Required.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GATEWAY_MASTER_KEY=

# Turns on the /admin API used by gateway-dashboard. Leave empty to keep it off.
GATEWAY_ADMIN_TOKEN=

# Base URL for the OpenAI-compatible provider (Azure OpenAI, Groq, local vLLM/Ollama, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
